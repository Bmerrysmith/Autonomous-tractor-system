# Copy to .env and fill in real values. .env is gitignored and must never be committed.
# Variable NAMES only here — no real secrets.

# Roboflow API key (used by the Roboflow MCP / dataset tooling, not by the
# agrinav package itself). Publishable keys start with `rf_`; keep private keys
# out of source control and rotate immediately if one is ever committed.
ROBOFLOW_API_KEY=
