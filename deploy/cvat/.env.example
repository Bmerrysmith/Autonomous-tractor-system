# AgriNav CVAT environment. Copy to `.env` in the CVAT clone (next to its
# docker-compose.yml) — that is where `docker compose` reads it from, not here.
#
#   cp deploy/cvat/.env.example <cvat-clone>/.env
#
# Never commit the filled-in copy: it names local paths, and CVAT_HOST exposes
# the machine if you ever set it.
#
# One variable per dataset. Each is published read-only at the matching path
# under /home/django/share (see docker-compose.override.yml). Nothing is copied:
# the images stay where they already live. What is *not* listed here is excluded
# on purpose — docs/cvat.md carries the mount table and the exclusion list with
# reasons.
#
# Windows: forward slashes. Paths below are the ones measured on this machine on
# 2026-08-21; `<you>` is the Windows user directory.

# --- detection: curated RICE on the grouped split (645 MB mounted) -----------
# 1,800 train + 518 valid images. The 261-image test split is NOT listed, and
# adding it here is how it stops being sealed. Don't, without a reason.
AGRINAV_RICE_TRAIN=C:/Users/<you>/Downloads/RICE_phase2_rebuild_2026-07-29/images/train
AGRINAV_RICE_VALID=C:/Users/<you>/Downloads/RICE_phase2_rebuild_2026-07-29/images/valid

# --- segmentation: expert masks ---------------------------------------------
# RiceSEG, ~3,078 rgb+label pairs (6,156 files, 231 MB).
AGRINAV_RICESEG=C:/Users/<you>/agrinav_data/incoming/extracted/riceseg
# "Rice Plant Image Dataset" (the misnamed RAR), 5,391 files, 1,557 MB.
AGRINAV_RICE_PLANT=C:/Users/<you>/agrinav_data/incoming/extracted/rice_plant_image_dataset

# --- classification: weed species -------------------------------------------
# BD weed V3, 11 species folders, 4,368 files, 261 MB. V4 is an exact subset of
# V3 and is deliberately not mounted.
AGRINAV_WEED_SPECIES=C:/Users/<you>/agrinav_data/incoming/extracted/weed_v3

# --- CVAT itself -------------------------------------------------------------

# Only needed to reach CVAT from another machine. Left unset, CVAT serves
# http://localhost:8080 and is not reachable from the network.
# CVAT_HOST=192.168.1.50

# Pin the CVAT image version instead of tracking the clone's default. Set this
# once the setup works, so a later `git pull` in the clone cannot change the
# annotation tool underneath an in-progress review round.
# CVAT_VERSION=v2.73.0   # latest release as of 2026-08-12; check before pinning
